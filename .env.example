# Copy to .env (gitignored) or export these in your shell. `make setup` will
# create .env for you and fill in the ffmpeg paths it finds.
#
# Use `~` for your home directory, not `$HOME`: these values are read by
# python-dotenv, which does not expand `$VAR`, while `~` is expanded when the
# path is resolved.

# ---------------------------------------------------------------------------
# Data roots. All three live OUTSIDE the repository.
# ---------------------------------------------------------------------------
# Read-only raw media: five date folders, each containing <session_id>.mp4
VC_DATA_ROOT=~/vc/raw
# Intermediates: audio, diarization segments, transcripts, per-frame data.
# Transcripts never leave this directory.
VC_WORK_ROOT=~/vc/work
# Outputs: inventory, previews, logs, aggregated features, handoff bundles.
VC_OUT_ROOT=~/vc/out

# ---------------------------------------------------------------------------
# ffmpeg / ffprobe
# ---------------------------------------------------------------------------
# On this machine ffmpeg comes from conda, so it is only on PATH while the
# conda environment is active. Pinning absolute paths here means the pipeline
# keeps working after `conda deactivate`. Leave unset to fall back to PATH.
VC_FFMPEG=
VC_FFPROBE=

# ---------------------------------------------------------------------------
# Optional: only needed for the local `pyannote` diarization backend.
# ---------------------------------------------------------------------------
HF_TOKEN=

# ---------------------------------------------------------------------------
# Optional: label OCR (`vc verify-layout`).
# ---------------------------------------------------------------------------
# Comma-separated fragments of the psychiatrist's Zoom name label, used to
# identify their tile directly. Normally unnecessary: the psychiatrist is
# identified by the fact that their label recurs across sessions while each
# participant's appears once. Set it here and nowhere else: this file is
# gitignored, and a real person's name must never be committed.
VC_PSYCHIATRIST_LABELS=
